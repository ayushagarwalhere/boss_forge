# Server-only settings. No key or Twitch account needed for npm run demo.
# Never prefix a secret with VITE_: those values are exposed to the browser.
OPENAI_API_KEY=
CODEX_API_KEY=
# Optional SDK model; omit to use the installed Codex default.
CODEX_MODEL=
# API moderation uses a platform key, not a Codex-only credential.
MODERATION_API_KEY=
# Omit to select api when a platform key exists, otherwise manual.
# manual always requires approval for viewer requests, even with AUTO_APPROVE=true.
MODERATION_MODE=
# Omit for live mode when a key exists, cached replay for no-key demo.
FORGE_MODE=
FORGE_TIMEOUT_MS=180000
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Enable only after npm run auth -- broadcaster and npm run auth -- bot.
# Demo mode always disconnects Twitch, even if this is true.
TWITCH_ENABLED=false
TWITCH_BROADCASTER_ID=
TWITCH_BOT_ID=
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_BROADCASTER_REFRESH_TOKEN=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback
TWITCH_REWARD_ID=
TWITCH_REWARD_COST=1000
PORT=8787
AUTO_APPROVE=false
