# M0 uses no credentials. Future milestones read .env.local on the server only.
# Never prefix a secret with VITE_: those values are exposed to the browser.
OPENAI_API_KEY=
CODEX_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_ID=
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_BROADCASTER_REFRESH_TOKEN=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback
TWITCH_REWARD_ID=
PORT=8787
AUTO_APPROVE=false
DEMO_MODE=true
