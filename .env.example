# M3 reads .env.local on the server only. No key needed for npm run demo.
# Never prefix a secret with VITE_: those values are exposed to the browser.
OPENAI_API_KEY=
CODEX_API_KEY=
# Optional SDK model; omit to use the installed Codex default.
CODEX_MODEL=
# Omit for live mode when a key exists, cached replay for no-key demo.
FORGE_MODE=
FORGE_TIMEOUT_MS=180000
# Twitch (optional). Create an app at https://dev.twitch.tv/console/apps with the
# OAuth Redirect URL http://localhost:8787/auth/callback, then connect accounts from /forge/.
# User tokens are stored in .artifacts/twitch/tokens.json (git-ignored), never here.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback
# Chat command viewers type. Also: !queue, !fight.
TWITCH_COMMAND=!boss
# auto = create/use a "Forge a boss" channel-point reward (Affiliate/Partner only); off = chat only.
TWITCH_REWARDS=auto
TWITCH_REWARD_TITLE=Forge a boss
TWITCH_REWARD_COST=500
# Moderation: viewer briefs are checked by a local filter (links, spam, this list) and, when
# OPENAI_API_KEY/CODEX_API_KEY is set, the OpenAI moderation API (fails closed if unreachable).
MODERATION_BLOCKLIST=
PORT=8787
AUTO_APPROVE=false
