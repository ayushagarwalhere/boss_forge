{
  "name": "boss-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chat designs the boss, Codex builds it, the streamer fights it.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:export": "tsx scripts/export-schema.ts",
    "bosses:validate": "tsx scripts/validate-bosses.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run bosses:validate"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
