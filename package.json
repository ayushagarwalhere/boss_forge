{
  "name": "boss-forge",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Chat designs the boss, Codex builds it, the streamer fights it.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx server/main.ts",
    "demo": "tsx server/main.ts --demo",
    "demo:record": "tsx scripts/record-demo.ts",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:export": "tsx scripts/export-schema.ts",
    "bosses:validate": "tsx scripts/validate-bosses.ts",
    "gate": "tsx scripts/gate.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run bosses:validate",
    "auth": "tsx scripts/auth.ts"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@openai/codex-sdk": "0.166.0",
    "dotenv": "18.0.9",
    "gsap": "3.13.0",
    "quickjs-emscripten-core": "0.32.0",
    "three": "0.180.0",
    "typescript": "5.9.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
